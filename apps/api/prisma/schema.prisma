// Family Hub Prisma schema. Snake_case column mapping keeps shared zod schemas
// in @family-hub/core parseable against API payloads. Row isolation, redemption
// rules, and star-balance aggregation are enforced in Nest services.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  parent
  child
}

enum TimeOfDay {
  morning
  afternoon
  evening
}

enum RedemptionStatus {
  pending
  approved
  rejected
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  members      Member[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Family {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  locale    String   @default("en")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  members          Member[]
  tasks            Task[]
  taskCompletions  TaskCompletion[]
  rewards          Reward[]
  redemptions      Redemption[]
  starAdjustments  StarAdjustment[]
  events           Event[]
  eventAttendees   EventAttendee[]
  gameProfiles     GameProfile[]
  gameQuests       GameQuestProgress[]
  gameLedger       GameLedgerEntry[]
  miniGameSessions MiniGameSession[]

  @@map("families")
}

model Member {
  id           String     @id @default(uuid()) @db.Uuid
  familyId     String     @map("family_id") @db.Uuid
  userId       String?    @map("user_id") @db.Uuid
  name         String
  avatarEmoji  String     @default("🙂") @map("avatar_emoji")
  color        String     @default("#3b82f6")
  role         MemberRole
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  assignedTasks         Task[]           @relation("TaskAssignee")
  taskCompletions       TaskCompletion[] @relation("CompletionMember")
  taskCompletionsByMe   TaskCompletion[] @relation("CompletionBy")
  redemptions           Redemption[]     @relation("RedemptionMember")
  redemptionsDecided    Redemption[]     @relation("RedemptionDecidedBy")
  starAdjustments       StarAdjustment[] @relation("AdjustmentMember")
  starAdjustmentsByMe   StarAdjustment[] @relation("AdjustmentCreatedBy")
  eventAttendees        EventAttendee[]
  gameProfile           GameProfile?
  gameQuests            GameQuestProgress[]
  gameLedger            GameLedgerEntry[]
  miniGameSessions      MiniGameSession[]

  @@unique([familyId, userId])
  @@index([userId])
  @@index([familyId])
  @@map("members")
}

model Task {
  id             String    @id @default(uuid()) @db.Uuid
  familyId       String    @map("family_id") @db.Uuid
  title          String
  icon           String    @default("✅")
  timeOfDay      TimeOfDay @map("time_of_day")
  stars          Int       @default(1)
  assigneeId     String?   @map("assignee_id") @db.Uuid
  recurrenceDays Int[]     @default([]) @map("recurrence_days") @db.SmallInt
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  active         Boolean   @default(true)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  family       Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  assignee     Member?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completions  TaskCompletion[]

  @@index([familyId])
  @@map("tasks")
}

model TaskCompletion {
  id            String   @id @default(uuid()) @db.Uuid
  familyId      String   @map("family_id") @db.Uuid
  taskId        String   @map("task_id") @db.Uuid
  memberId      String   @map("member_id") @db.Uuid
  completedOn   DateTime @map("completed_on") @db.Date
  completedBy   String?  @map("completed_by") @db.Uuid
  starsAwarded  Int      @default(0) @map("stars_awarded")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  family       Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  task         Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member       Member  @relation("CompletionMember", fields: [memberId], references: [id], onDelete: Cascade)
  completedByMember Member? @relation("CompletionBy", fields: [completedBy], references: [id], onDelete: SetNull)

  @@unique([taskId, memberId, completedOn])
  @@index([memberId, completedOn])
  @@map("task_completions")
}

model Reward {
  id          String  @id @default(uuid()) @db.Uuid
  familyId    String  @map("family_id") @db.Uuid
  title       String
  icon        String  @default("🎁")
  starCost    Int     @map("star_cost")
  maxPerWeek  Int?    @map("max_per_week")
  active      Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  redemptions Redemption[]

  @@index([familyId])
  @@map("rewards")
}

model Redemption {
  id          String           @id @default(uuid()) @db.Uuid
  familyId    String           @map("family_id") @db.Uuid
  rewardId    String           @map("reward_id") @db.Uuid
  memberId    String           @map("member_id") @db.Uuid
  starsSpent  Int              @default(0) @map("stars_spent")
  status      RedemptionStatus @default(pending)
  requestedAt DateTime         @default(now()) @map("requested_at") @db.Timestamptz
  decidedBy   String?          @map("decided_by") @db.Uuid
  decidedAt   DateTime?        @map("decided_at") @db.Timestamptz

  family           Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  reward           Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  member           Member @relation("RedemptionMember", fields: [memberId], references: [id], onDelete: Cascade)
  decidedByMember  Member? @relation("RedemptionDecidedBy", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([memberId, requestedAt])
  @@map("redemptions")
}

model StarAdjustment {
  id        String   @id @default(uuid()) @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  delta     Int
  reason    String   @default("")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  family           Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member           Member  @relation("AdjustmentMember", fields: [memberId], references: [id], onDelete: Cascade)
  createdByMember  Member? @relation("AdjustmentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@map("star_adjustments")
}

model Event {
  id        String   @id @default(uuid()) @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  title     String
  startsAt  DateTime @map("starts_at") @db.Timestamptz
  endsAt    DateTime @map("ends_at") @db.Timestamptz
  allDay    Boolean  @default(false) @map("all_day")
  location  String?
  notes     String?
  color     String   @default("#10b981")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  family    Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  attendees EventAttendee[]

  @@index([familyId, startsAt])
  @@map("events")
}

model EventAttendee {
  eventId  String @map("event_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  familyId String @map("family_id") @db.Uuid

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([eventId, memberId])
  @@map("event_attendees")
}

// --- Adventure game -------------------------------------------------------
// Resources (xp, coins, crystals, materials) are never stored as a balance:
// they are summed from game_ledger, whose (member_id, source_key) uniqueness
// makes every reward grant idempotent.

enum GameQuestStatus {
  active
  rewarded
  cancelled
}

model GameProfile {
  memberId  String   @id @map("member_id") @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  avatar    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("game_profiles")
}

model GameQuestProgress {
  id         String          @id @default(uuid()) @db.Uuid
  familyId   String          @map("family_id") @db.Uuid
  memberId   String          @map("member_id") @db.Uuid
  questKey   String          @map("quest_key")
  periodKey  String          @map("period_key")
  status     GameQuestStatus @default(active)
  acceptedAt DateTime        @default(now()) @map("accepted_at") @db.Timestamptz
  rewardedAt DateTime?       @map("rewarded_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, questKey, periodKey])
  @@index([familyId])
  @@map("game_quest_progress")
}

model GameLedgerEntry {
  id        String   @id @default(uuid()) @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  sourceKey String   @map("source_key")
  xp        Int      @default(0)
  coins     Int      @default(0)
  crystals  Int      @default(0)
  materials Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, sourceKey])
  @@index([familyId])
  @@map("game_ledger")
}

model MiniGameSession {
  id         String    @id @default(uuid()) @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  memberId   String    @map("member_id") @db.Uuid
  game       String
  level      Int
  deck       Int[]     @db.SmallInt
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  won        Boolean   @default(false)
  moves      Int?
  score      Int?
  durationMs Int?      @map("duration_ms")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, game, startedAt])
  @@index([familyId])
  @@map("minigame_sessions")
}
